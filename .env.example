# tDocs — salin menjadi `.env`, lalu jalankan `tdocs setup`
# (atau isi manual bila lebih suka). File `.env` di-gitignore: jangan commit.
#
# Ambil sekali saja dari https://my.telegram.org → API development tools.

# Wajib sekali saja: kredensial Telegram
TDOCS_TG_APP_ID=
TDOCS_TG_APP_HASH=

# Dashboard + API (opsional, ini defaultnya)
TDOCS_ADMIN_PASSWORD=admin123
TDOCS_PORT=8080
TDOCS_HOST=0.0.0.0

# Database SQLite (default: tdocs.db di folder kerja)
# TDOCS_DB_PATH=tdocs.db

# Kunci enkripsi sesi MTProto — kosongkan = otomatis dibuat (.tdocs.key).
# Ganti kunci setelah login = sesi lama tidak terbaca → `tdocs login --reset`.
# TDOCS_SECRET_KEY=

# CDN publik untuk embed <video>/<audio>/<img> (default true).
# Set false untuk mengunci /cdn/* di balik Bearer key.
# TDOCS_CDN_PUBLIC=true
# Bila di-reverse-proxy, agar stream_url memakai domain publik:
# TDOCS_CDN_BASE_URL=https://domain.mu

# Browser otomatis saat `server`/`start` (default buka bila interaktif).
# TDOCS_NO_BROWSER=1

# HTTPS native (opsional): isi keduanya untuk menyajikan dashboard via TLS.
# TDOCS_TLS_CERT_FILE=/path/to/fullchain.pem
# TDOCS_TLS_KEY_FILE=/path/to/privkey.pem

# Built-in ACME HTTPS: cukup arahkan domain ke IP server, lalu isi domain di
# Settings → Public Domain & HTTPS. Port default 80/443; ubah hanya bila bentrok.
# TDOCS_HTTP_PORT=80
# TDOCS_HTTPS_PORT=443

# Interval snapshot otomatis (format durasi Go, default 24 jam).
# TDOCS_BACKUP_INTERVAL=24h

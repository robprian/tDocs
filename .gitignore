# Runtime data & secrets — never commit
*.db
*.db-wal
*.db-shm
*.db-journal
.env
*.key
.tdocs.pid
tdocs.log
*.log

# Build artifacts — only the root binary and packaged output, never sources.
# NOTE: do NOT use a bare `tdocs` pattern — that also ignores cmd/tdocs/.
/tdocs
/tdocs.exe
/bin/tdocs
/bin/tdocs.exe
dist/

# Brand assets embedded in the UI must ship with the source (CI builds them).
references.png
*.png
!docs/screenshots/*.png
!internal/web/static/*.png

# Agent scratch & QA captures
.scratch/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local tooling
.commandcode/
.verify7/
